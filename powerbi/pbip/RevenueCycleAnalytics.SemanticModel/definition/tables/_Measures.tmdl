table _Measures
	lineageTag: 81947feb-6749-471c-a024-9077db0e2178

	measure 'Total Claims' = COUNTROWS(fact_claims)
		formatString: #,0
		lineageTag: 01e80abe-376e-444b-912c-e7263f9e1c0a

	measure 'Adjudicated Claims' = CALCULATE(COUNTROWS(fact_claims), fact_claims[status] IN {"Paid", "Denied"})
		formatString: #,0
		lineageTag: 6cfaba6d-4266-4ea4-be96-4a6c1f89b1a6

	measure 'Denied Claims' = CALCULATE(COUNTROWS(fact_claims), fact_claims[status] = "Denied")
		formatString: #,0
		lineageTag: 134de257-19bc-4b9e-a10c-4dab69b92351

	measure 'Denial Rate' = DIVIDE([Denied Claims], [Adjudicated Claims])
		formatString: 0.0%
		lineageTag: 5f153d31-42b6-4fc8-95c6-cd4506be5adf

	measure 'Denial Rate Target' = 0.05
		formatString: 0.0%
		lineageTag: 96b97d2e-f58c-48e6-96d5-b3204be88f5f

	measure 'Denied $' = CALCULATE(SUM(fact_claims[submitted_amount]), fact_claims[status] = "Denied")
		formatString: \$#,0
		lineageTag: ef1374a7-ce14-498f-a7a7-40121490e198

	measure 'Submitted $' = SUM(fact_claims[submitted_amount])
		formatString: \$#,0
		lineageTag: 121bbe6e-f741-4c4d-bf3a-6ac6de87cf8c

	measure 'Allowed $' = SUM(fact_claims[allowed_amount])
		formatString: \$#,0
		lineageTag: b84d00c4-598d-489f-b963-32568064e1e3

	measure 'Paid $' = SUM(fact_claims[paid_amount])
		formatString: \$#,0
		lineageTag: f78ff2ab-df6e-463a-94b5-370cb6dbb81f

	measure 'Net Collection Rate' = DIVIDE([Paid $], [Allowed $])
		formatString: 0.0%
		lineageTag: 29ea5eb7-edf9-4453-a29f-93ba8b90e989

	measure 'Clean Claim Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_claims), fact_claims[status] = "Paid", fact_claims[resubmitted] = 0), [Adjudicated Claims])
		formatString: 0.0%
		lineageTag: 8dd811be-1a45-4916-92be-2713368bbd6c

	measure 'Avg Days to Adjudicate' = AVERAGE(fact_claims[days_to_adjudicate])
		formatString: #,0.0
		lineageTag: af218569-8866-47d7-9bc6-54c5a895c78f

	measure 'Pending Claims' = CALCULATE(COUNTROWS(fact_claims), fact_claims[status] = "Pending")
		formatString: #,0
		lineageTag: 8c7b6bb7-8726-4e95-9883-5775d52ecb62

	measure 'Open AR $' = CALCULATE(SUM(fact_claims[submitted_amount]), fact_claims[status] = "Pending")
		formatString: \$#,0
		lineageTag: b0431cf7-5629-4831-8dc8-bfebb721a7ee

	measure 'AR Over 90 $' = CALCULATE(SUM(fact_claims[submitted_amount]), fact_claims[status] = "Pending", fact_claims[ar_bucket] IN {"91-120", "120+"})
		formatString: \$#,0
		lineageTag: fd2e6944-9132-42b5-8342-461853620ab4

	measure '% AR Over 90' = DIVIDE([AR Over 90 $], [Open AR $])
		formatString: 0.0%
		lineageTag: 21c3dc7d-64f6-48c8-a200-a0c1399f58af

	measure 'Contractual Adjustment $' = CALCULATE(SUM(fact_claims[submitted_amount]) - SUM(fact_claims[allowed_amount]), fact_claims[status] = "Paid")
		formatString: \$#,0
		lineageTag: 939a4c6a-bb93-49e8-b392-7320a88628df

	measure 'Gross AR (Worklist) $' = SUM(ar_yield_predictions[billed_amount])
		formatString: \$#,0
		lineageTag: a7c10001-0000-4000-8000-000000000001

	measure 'Expected NRV $' = SUM(ar_yield_predictions[expected_nrv])
		formatString: \$#,0
		lineageTag: a7c10001-0000-4000-8000-000000000002

	measure 'Bad Debt Reserve $' = [Gross AR (Worklist) $] - [Expected NRV $]
		formatString: \$#,0
		lineageTag: a7c10001-0000-4000-8000-000000000003

	measure 'NRV Realization Rate' = DIVIDE([Expected NRV $], [Gross AR (Worklist) $])
		formatString: 0.0%
		lineageTag: a7c10001-0000-4000-8000-000000000004

	measure 'Worklist Claims' = COUNTROWS(ar_yield_predictions)
		formatString: #,0
		lineageTag: a7c10001-0000-4000-8000-000000000005

	measure Discharges = COUNTROWS(fact_inpatient_abstracts)
		formatString: #,0
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20001-0000-4000-8000-000000000000

	measure 'Weighted Cases' = SUM(fact_inpatient_abstracts[riw])
		formatString: #,0.0
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20002-0000-4000-8000-000000000000

	measure 'Acute Cost' = SUM(fact_inpatient_abstracts[total_cost])
		formatString: \$#,0
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20003-0000-4000-8000-000000000000

	measure 'Cost per Weighted Case' = DIVIDE([Acute Cost], [Weighted Cases])
		formatString: \$#,0
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20004-0000-4000-8000-000000000000

	measure 'ALC Days' = SUM(fact_inpatient_abstracts[alc_days])
		formatString: #,0
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20005-0000-4000-8000-000000000000

	measure 'ALC Cost' = [ALC Days] * 1150
		formatString: \$#,0
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20006-0000-4000-8000-000000000000

	measure 'Cost per Weighted Case ex-ALC' = DIVIDE([Acute Cost] - [ALC Cost], [Weighted Cases])
		formatString: \$#,0
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20007-0000-4000-8000-000000000000

	measure 'Patient Days' = SUM(fact_inpatient_abstracts[total_los_days])
		formatString: #,0
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20008-0000-4000-8000-000000000000

	measure 'ALC Rate' = DIVIDE([ALC Days], [Patient Days])
		formatString: 0.0%
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20009-0000-4000-8000-000000000000

	measure 'ALC Bed Equivalents' = DIVIDE([ALC Days], 730)
		formatString: #,0.0
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20010-0000-4000-8000-000000000000

	measure 'Stays with ALC' = CALCULATE(COUNTROWS(fact_inpatient_abstracts), fact_inpatient_abstracts[alc_days] > 0)
		formatString: #,0
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20011-0000-4000-8000-000000000000

	measure 'ALC Stay Rate' = DIVIDE([Stays with ALC], [Discharges])
		formatString: 0.0%
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20012-0000-4000-8000-000000000000

	measure Readmissions = SUM(fact_inpatient_abstracts[readmit_30d])
		formatString: #,0
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20013-0000-4000-8000-000000000000

	measure 'Readmission Rate' = DIVIDE([Readmissions], [Discharges])
		formatString: 0.0%
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20014-0000-4000-8000-000000000000

	measure 'Readmission O/E' = DIVIDE(SUM(activity_by_facility[observed_readmits]), SUM(activity_by_facility[expected_readmits]))
		formatString: 0.000
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20015-0000-4000-8000-000000000000

	measure 'LOS Index' = DIVIDE(SUM(activity_by_facility[acute_days]), SUM(activity_by_facility[expected_acute_days]))
		formatString: 0.000
		displayFolder: Acute activity (Canada)
		lineageTag: c8a20016-0000-4000-8000-000000000000

	measure 'Incremental Cost' = SUM(hta_base_case[incremental_cost])
		formatString: \$#,0
		displayFolder: Health economics
		lineageTag: c8a20017-0000-4000-8000-000000000000

	measure 'Incremental QALYs' = SUM(hta_base_case[incremental_qalys])
		formatString: #,0.0
		displayFolder: Health economics
		lineageTag: c8a20018-0000-4000-8000-000000000000

	measure 'Net Monetary Benefit' = SUM(hta_base_case[net_monetary_benefit])
		formatString: \$#,0
		displayFolder: Health economics
		lineageTag: c8a20019-0000-4000-8000-000000000000

	measure ICER = IF(HASONEVALUE(hta_base_case[perspective]), IF(SELECTEDVALUE(hta_base_case[dominant]) = "True", BLANK(), DIVIDE([Incremental Cost], [Incremental QALYs])), BLANK())
		formatString: #,0
		displayFolder: Health economics
		lineageTag: c8a20020-0000-4000-8000-000000000000

	measure 'p-prime Centre Line' = AVERAGE(spc_alc_stay[centre])
		formatString: 0.0%
		displayFolder: Statistical process control
		lineageTag: c8a30001-0000-4000-8000-000000000000

	measure 'p-prime Lower Limit' = AVERAGE(spc_alc_stay[lcl])
		formatString: 0.0%
		displayFolder: Statistical process control
		lineageTag: c8a30002-0000-4000-8000-000000000000

	measure 'p-prime Upper Limit' = AVERAGE(spc_alc_stay[ucl])
		formatString: 0.0%
		displayFolder: Statistical process control
		lineageTag: c8a30003-0000-4000-8000-000000000000

	measure 'Denial Rate vs Target' = [Denial Rate] - [Denial Rate Target]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Verdict
		lineageTag: 57384542-1ef2-5d35-a4fb-940527931c0a

	measure 'Denial Rate Status' =
			VAR Actual = [Denial Rate]
			VAR Target = [Denial Rate Target]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Actual), "No data",
			        Actual <= Target, "On target",
			        Actual <= Target + 0.01, "Watch",
			        "Off target"
			    )
		displayFolder: Verdict
		lineageTag: bbd38b8c-052b-56ad-b620-d2812ebcee99

	measure 'Denial Rate Colour' =
			SWITCH(
			    [Denial Rate Status],
			    "On target", "#3DD68C",
			    "Watch", "#F5A524",
			    "No data", "#454A82",
			    "#FF5C7A"
			)
		displayFolder: Verdict
		lineageTag: 0bec4673-f3a0-5121-87ed-ac517da4a9ba

	measure 'Denial Rate Reference' =
			VAR Gap = [Denial Rate vs Target]
			VAR Above = Gap >= 0
			RETURN
			    "Target " & FORMAT([Denial Rate Target], "0.0%") & "   "
			        & IF(Above, "▲", "▼") & " "
			        & FORMAT(ABS(Gap) * 100, "0.0") & " pts" & IF(Above, " over", " under")
		displayFolder: Verdict
		lineageTag: e74543f1-faf7-509d-b812-b70498cb9c06

	measure 'Collection Reference' = "Paid " & FORMAT(DIVIDE([Paid $], 1000000), "\$#,0.0") & "M" & " of " & FORMAT(DIVIDE([Allowed $], 1000000), "\$#,0.0") & "M" & " allowed"
		displayFolder: Verdict
		lineageTag: 28038611-9543-5ff9-ad9f-21f44c82bd7c

	measure 'AR Reference' = "Over 90 days " & FORMAT(DIVIDE([AR Over 90 $], 1000000), "\$#,0.0") & "M" & "   " & FORMAT([% AR Over 90], "0.0%") & " of book"
		displayFolder: Verdict
		lineageTag: fe33f1b0-abbc-566f-8885-674c754d086f

	measure 'NRV Reference' = "Gross " & FORMAT(DIVIDE([Gross AR (Worklist) $], 1000000), "\$#,0.0") & "M" & "   realisation " & FORMAT([NRV Realization Rate], "0.0%")
		displayFolder: Verdict
		lineageTag: 5e7c621d-de58-53de-b50f-5d2cf0b2e4f0

	measure 'Payer Denial Colour' =
			IF(
			    [Denial Rate] > [Denial Rate Target],
			    "#FF5C7A",
			    "#454A82"
			)
		displayFolder: Verdict
		lineageTag: ba948b98-b53a-51ca-944d-929383e3bb81

	/// Highlights the largest value on the axis and recedes the rest.
	/// The bare ALLSELECTED() is what makes this work inside a conditional
	/// format: it restores the VISUAL's filter context, so VALUES() is the
	/// axis rather than the single data point. Iterating the column alone
	/// leaves the point's own filter in place and every bar matches itself;
	/// iterating the table walks rows, which is not the axis unless the
	/// dimension happens to have one row per value.
	measure 'Denial Reason Colour' =
			VAR Here = [Denied $]
			VAR Extreme =
			    CALCULATE(
			        MAXX(VALUES(fact_claims[denial_reason]), [Denied $]),
			        ALLSELECTED()
			    )
			RETURN
			    IF(Here = Extreme, "#FF5C7A", "#454A82")
		displayFolder: Verdict
		lineageTag: a64cca57-fdce-5b2e-978b-1cb6a0c4b61b

	/// Deterministic narrative for the RCM scorecard.
	measure 'RCM Insight' =
			VAR Rate = [Denial Rate]
			VAR Gap = Rate - [Denial Rate Target]
			VAR WorstReason =
			    MAXX(TOPN(1, VALUES(fact_claims[denial_reason]), [Denied $], DESC), fact_claims[denial_reason])
			VAR WorstDollars = CALCULATE([Denied $], fact_claims[denial_reason] = WorstReason)
			RETURN
			    "Denial rate " & FORMAT(Rate, "0.0%") & " against a " & FORMAT([Denial Rate Target], "0.0%")
			        & " target — " & IF(Gap <= 0, "on target", FORMAT(Gap * 100, "0.0") & " pts over")
			        & ". " & WorstReason & " is the costliest reason at " & FORMAT(WorstDollars, "\$#,0")
			        & ", and " & FORMAT([% AR Over 90], "0.0%") & " of open AR is already past 90 days."
		displayFolder: Verdict
		lineageTag: 26d58fad-5547-5586-bf10-cfa6b5792b07

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fd4e8534-e18a-4551-948c-a38f325e234d
		summarizeBy: none
		sourceColumn: Value

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Value = Int64.Type], {})
				in
				    Source

