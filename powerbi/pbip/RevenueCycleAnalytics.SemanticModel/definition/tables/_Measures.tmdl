			VAR vShown = IF(ISBLANK(vValue), "—", FORMAT(vValue, "0.0%"))
			VAR vCaptionRaw = SUBSTITUTE(SUBSTITUTE(COALESCE([Denial Rate Reference], ""), "&", "&amp;"), "<", "&lt;")
